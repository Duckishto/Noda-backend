generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Community ───────────────────────────────────────────────
// แต่ละชุมชนที่ deploy Firebase แยกกัน
model Community {
  id          String  @id @default(cuid())
  name        String
  domain      String  @unique
  description String?
  createdAt   DateTime @default(now())

  members       CommunityMember[]
  posts         Post[]
  announcements Announcement[]
}

// ─── User ─────────────────────────────────────────────────────
// บัญชีเดียวใช้ได้ทุก community
// ไม่มี role และไม่มี communityId อยู่ตรงนี้
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique   // email เดียวทั่วระบบ
  password  String
  createdAt DateTime @default(now())

  memberships   CommunityMember[]
  posts         Post[]
  announcements Announcement[]
}

// ─── CommunityMember ──────────────────────────────────────────
// role ของ user ใน community นั้นๆ
// admin เฉพาะ community ของตัวเอง ไป community อื่นเป็น user
model CommunityMember {
  userId      Int
  communityId String
  role        Role     @default(user)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId],      references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])   // composite key
}

enum Role {
  admin
  user
}

// ─── Post ─────────────────────────────────────────────────────
model Post {
  id          Int          @id @default(autoincrement())
  title       String
  template    PostTemplate
  category    PostCategory
  tags        String[]
  authorId    Int
  communityId String
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author    User      @relation(fields: [authorId],    references: [id])
  community Community @relation(fields: [communityId], references: [id])
}

enum PostTemplate {
  dictionary
  map
  story
  audio
}

enum PostCategory {
  language
  wisdom
  story
  cultural_map
  food
  ritual
}

// ─── Announcement ─────────────────────────────────────────────
model Announcement {
  id          Int              @id @default(autoincrement())
  title       String
  body        String
  type        AnnouncementType @default(general)
  eventDate   DateTime?
  authorId    Int
  communityId String
  createdAt   DateTime         @default(now())

  author    User      @relation(fields: [authorId],    references: [id])
  community Community @relation(fields: [communityId], references: [id])
}

enum AnnouncementType {
  general
  event
  urgent
}
